# Copy this file to .env and fill in real values. Never commit .env itself
# (or token.txt, if you keep that pattern from the Python version).

# Your Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs who should be root admins
ADMIN_IDS=

# Your deployed HTTPS URL (Render, etc.) once you know it
WEBAPP_URL=

MONGODB_URL=

# Port for the Express server (Render sets this automatically in production)
PORT=
